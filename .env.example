# ---- As the Spirit Leads: environment configuration ----
# Copy this file to ".env" and fill in the values you have.
# The app reads plain environment variables (no dotenv required):
#   Windows (PowerShell):  $env:SMTP_HOST="smtp.gmail.com"; node server.js
#   Or use start.bat which loads .env automatically.

# Server
PORT=3000
HOST=0.0.0.0

# Email notifications (Gmail app password recommended)
# 1. Enable 2-Step Verification on the Gmail account
# 2. Create an App Password (Google Account -> Security -> App passwords)
# 3. Use that 16-character password below (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=asthespiritleads@gmail.com
SMTP_PASS=
SMTP_FROM=As the Spirit Leads <asthespiritleads@gmail.com>

# Alternative: Resend (https://resend.com) - leave SMTP settings empty to use this
RESEND_API_KEY=

# WhatsApp Cloud API (Meta) - https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
